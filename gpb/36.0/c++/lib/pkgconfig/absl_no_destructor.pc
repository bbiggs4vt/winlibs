prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}

Name: absl_no_destructor
Description: Abseil no_destructor library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_nullability = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
