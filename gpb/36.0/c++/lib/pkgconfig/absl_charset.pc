prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}

Name: absl_charset
Description: Abseil charset library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_string_view = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
