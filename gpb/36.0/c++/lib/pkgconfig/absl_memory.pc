prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}

Name: absl_memory
Description: Abseil memory library
URL: https://abseil.io/
Version: 20250512
Requires: absl_core_headers = 20250512, absl_meta = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
