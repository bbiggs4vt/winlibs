prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}

Name: absl_atomic_hook
Description: Abseil atomic_hook library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_core_headers = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
