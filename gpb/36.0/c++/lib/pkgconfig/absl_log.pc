prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}

Name: absl_log
Description: Abseil log library
URL: https://abseil.io/
Version: 20250512
Requires: absl_log_internal_log_impl = 20250512, absl_vlog_is_on = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
