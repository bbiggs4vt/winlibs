prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}

Name: absl_demangle_internal
Description: Abseil demangle_internal library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_demangle_rust = 20250512
Libs: -L${libdir}  -labsl_demangle_internal 
Cflags: -I${includedir} -DNOMINMAX
