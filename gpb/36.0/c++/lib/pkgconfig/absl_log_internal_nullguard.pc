prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}

Name: absl_log_internal_nullguard
Description: Abseil log_internal_nullguard library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_core_headers = 20250512
Libs: -L${libdir}  -labsl_log_internal_nullguard 
Cflags: -I${includedir} -DNOMINMAX
